{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=secureops_lab;Username=secureops;Password=secureops_lab_password"
  },
  "SecurityLab": {
    "Vulnerabilities": {
      "A01BrokenAccessControl": true,
      "A03Injection": true,
      "A05SecurityMisconfiguration": true,
      "A10ServerSideRequestForgery": true
    },
    "ObjectStorage": {
      "ServiceUrl": "http://localhost:4566",
      "Region": "us-east-1",
      "BucketName": "secureops-lab-documents",
      "AccessKey": "test",
      "SecretKey": "test"
    },
    "CloudLogging": {
      "ServiceUrl": "http://localhost:4566",
      "Region": "us-east-1",
      "LogGroupName": "/secureops-lab/security-events",
      "LogStreamName": "lab-runtime",
      "AccessKey": "test",
      "SecretKey": "test"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "SecureOpsLab.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
