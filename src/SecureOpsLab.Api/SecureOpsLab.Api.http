Accept: application/json
X-Lab-User-Id: {{AliceId}}

###

GET {{SecureOpsLab.Api_HostAddress}}/api/vulnerabilities/a03-injection/documents/search?term=Alice
Accept: application/json
X-Lab-User-Id: {{AliceId}}

###

GET {{SecureOpsLab.Api_HostAddress}}/api/vulnerabilities/a03-injection/documents/search?term={{SqlInjectionPayload}}
Accept: application/json
X-Lab-User-Id: {{AliceId}}

###

GET {{SecureOpsLab.Api_HostAddress}}/api/vulnerabilities/a04-insecure-design/emergency-access
Accept: application/json
X-Lab-User-Id: {{AliceId}}

###

